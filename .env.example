# 复制为 .env 后填写。仓库内不得提交真实密钥。
# 管理员登录口令（非空；Argon2 哈希在启动自检时写入数据库）
AW_ADMIN_PASSWORD=change-me

# 提供商密钥加密密钥：必须为 32 字节的 base64 编码（AES-256-GCM）
# 生成示例：python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AW_DGSGDVJWVN_LYG=

# 数据库连接串；留空时使用 sqlite+aiosqlite:///<AW_DATA_DIR>/workbench.db
# 生产：mysql+asyncmy://user:password@127.0.0.1:3306/workbench?charset=utf8mb4
AW_DATABASE_URL=

# 数据目录（制品、临时文件、trash 与会话文件）
AW_DATA_DIR=./data

# 浏览器访问本站的公开 Origin（CSRF 校验）；多个以逗号分隔
AW_PUBLIC_ORIGIN=http://127.0.0.1:8000

# Cookie Secure 属性：auto | true | false
AW_COOKIE_SECURE=auto

# 位于受信反向代理之后时开启（读取 X-Forwarded-For）
AW_TRUST_PROXY=false

# 是否允许非本机地址访问（默认仅 127.0.0.1）
AW_ALLOW_REMOTE=false

# AI 调用进程内并发上限
AW_AI_MAX_CONCURRENCY=4

# 单次提示最大字符数
AW_PROMPT_MAX_CHARS=200000
