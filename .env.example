# 复制为 .env 后填写。仓库内不得提交真实密钥。
# 管理员登录口令（非空；Argon2 哈希在启动自检时写入数据库）
VIGIL_ADMIN_PASSWORD=change-me

# 提供商密钥加密密钥：必须为 32 字节的 base64 编码（AES-256-GCM）
# 生成示例：python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VIGIL_ENCRYPTION_KEY=

# 仓库令牌加密密钥：必须为 32 字节 base64；与提供商密钥独立，可单独轮换。
# 缺失或非法时启动自检拒绝启动。生成方式同上。
VIGIL_REPO_TOKEN_KEY=<占位>

# 数据库连接串；留空时使用 sqlite+aiosqlite:///<VIGIL_DATA_DIR>/vigil.db
# 生产：mysql+asyncmy://user:password@127.0.0.1:3306/vigil?charset=utf8mb4
VIGIL_DATABASE_URL=

# 数据目录（制品、临时文件、trash 与会话文件）
VIGIL_DATA_DIR=./data

# 浏览器访问本站的公开 Origin（CSRF 校验）；多个以逗号分隔
VIGIL_PUBLIC_ORIGIN=http://127.0.0.1:8000

# Cookie Secure 属性：auto | true | false
VIGIL_COOKIE_SECURE=auto

# 位于受信反向代理之后时开启（读取 X-Forwarded-For）
VIGIL_TRUST_PROXY=false

# 是否允许非本机地址访问（默认仅 127.0.0.1）
VIGIL_ALLOW_REMOTE=false

# AI 调用进程内并发上限
VIGIL_AI_MAX_CONCURRENCY=4

# 单次提示最大字符数
VIGIL_PROMPT_MAX_CHARS=200000

# docker compose（mysql:8.4）用占位，勿填真实口令。
# 容器内若未设置 VIGIL_DATABASE_URL，入口脚本会按下面四个变量拼连接串。
MYSQL_DATABASE=vigil
MYSQL_USER=vigil
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
